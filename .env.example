APP_ENV=dev
PORT=8080
BASE_URL=http://localhost:8080
LOG_LEVEL=debug
DATABASE_URL=postgres://shortener:shortener@localhost:5434/shortener?sslmode=disable
SHUTDOWN_TIMEOUT=10s
REQUEST_TIMEOUT=15s
MIGRATE_ON_START=true
DB_MAX_CONNS=10
DB_MIN_CONNS=2
# Local only: act as this api_keys.id without auth. Create it with `task dev:seed`.
DEV_API_KEY_ID=1
