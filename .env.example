APP_ENV=dev
PORT=8080
BASE_URL=http://localhost:8080
LOG_LEVEL=debug
DATABASE_URL=postgres://shortener:shortener@localhost:5434/shortener?sslmode=disable
SHUTDOWN_TIMEOUT=10s
REQUEST_TIMEOUT=15s
MIGRATE_ON_START=true
DB_MAX_CONNS=10
DB_MIN_CONNS=2
# Comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For.
# Leave empty when clients connect directly.
TRUSTED_PROXIES=
RATE_LIMIT_CREATE_PER_SEC=10
RATE_LIMIT_REDIRECT_PER_SEC=100
# Click analytics: redirects enqueue clicks; one goroutine flushes them in
# batches. Clicks older than CLICK_RETENTION are purged every
# CLICK_PURGE_INTERVAL (0 disables the in-process purger; use task clicks:purge).
CLICK_BUFFER_SIZE=10000
CLICK_FLUSH_INTERVAL=1s
CLICK_FLUSH_BATCH=500
CLICK_RETENTION=2160h
CLICK_PURGE_INTERVAL=24h
